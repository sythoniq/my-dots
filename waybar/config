{
	"layer": "top",
	"margin-top": 0,
	"margin-bottom": 0,
	"margin-left": 0,
	"margin-right": 0,
	"spacing": 0,

	"modules-left": [
		"custom/appmenu",
		"hyprland/workspaces",
		"custom/empty"
	],

	"modules-center": [
		"clock",
		"custom/empty"
	],

	"modules-right": [
		"pulseaudio",
		"backlight",
		"network",
		"battery",
	],

	"hyprland/workspaces": {
		"on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
		"on-scroll-up":   "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
		"on-click": "activate",
		"active-only": false,
		"all-outputs": true,
		"format": "{}",
		"format-icons": {
			"urgent": "",
			"active": "",
			"default": ""
		},
		"persistent-workspaces": {
			"*": 5
		}
	},

	"custom/empty": {
		"format": ""
	},

	"custom/appmenu": {
		"format": "󰞷",
		"on-click": "rofi -show drun",
		"tooltip-format": "Left: Open the application launcher\n"
	},

	"clock": {
		"format": "{:%H:%M %a}",
		"on-click": "qs ipc call calendar toggle",
		"timezone": "",
		"tooltip": false
	},

	"network": {
		"format": "{ifname}",
		"format-wifi": " ",
		"format-disconnected": "Disconnected ⚠",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 50,
	},

	"battery": {
		"interval": 1,
		"states": {
			// "good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{icon} {time}",
		// "format-good": "", // An empty format will hide the module
		"format-full": "{icon}",
		"format-icons": [
			" ",
			" ",
			" ",
			" ",
			" "
		]
	},

		// Pulseaudio
		"pulseaudio": {
			"format": "{icon} {volume}%",
			"format-bluetooth": "{icon} 󰂰 {volume}%",
			"format-muted": "󰖁",
			"format-icons": {
				"headphone": "",
				"hands-free": "",
				"headset": "",
				"default": [
					"", "", "󰕾",  ""
				]
			}
		},

		// backlight:
		"backlight": {
			"format": "{icon} {percent}%",
			"format-icons": [
				"",
				"",
				""
			],
			"scroll-step": 10
		}
}
